{
  "$schema": "https://opencode.ai/config.json",
  "model": "proxy/warrant-officer",
  "small_model": "proxy/sergeant",
  "mcp": {
    "biomcp": {
      "type": "local",
      "command": [
        "biomcp",
        "serve"
      ],
      "enabled": true
    },
    "scite": {
      "type": "remote",
      "url": "https://api.scite.ai/mcp",
      "enabled": false
    }
  },
  "instructions": [
    "Read AGENTS.md for project context.",
    "Read .opencode/agents/*.md for agent definitions.",
    "Tiers are rank names on the LiteLLM proxy (proxy/<rank>); the proxy hides which model holds a rank, so agent configs never name a model. (1) proxy/sergeant = fast executor: mechanical, build-verified, high-volume, faithful instruction following, cheap workers; explicit-only, no auto-fallback. (2) proxy/warrant-officer = workhorse: agentic judgment, code generation and fix loops, long-form generation, domain audits; the default delegation tier and main-session model. (3) proxy/second-lieutenant = clean-output language tier: style, tone, translation, prose-pattern audits. (4) proxy/lieutenant = deep reasoning: formal proofs, math verification, adversarial persona auditors, model builders, high-stakes medical analysis; proxy cascades a failed lieutenant to second-lieutenant then warrant-officer. (5) Vision tier: the -v sibling ranks are the only vision slots — proxy/warrant-officer-v and proxy/lieutenant-v serve the same models as their text ranks, which are text-only by contract. Agents that read rendered figures, SVGs, PDFs (validators, checkers, illustrators) run on proxy/warrant-officer-v; deep visual rhetoric (diagram-rhetoric-auditor) runs on proxy/lieutenant-v. proxy/lieutenant-colonel-v remains for paid frontier visual work. Do not add provider-specific thinking/reasoning_effort options to rank agents; the proxy owns model behaviour parameters."
  ],
  "plugin": [
    "../llm-harness-plugins/context-includes/opencode/index.ts",
    "../llm-harness-plugins/guardrail-chain/opencode/index.ts",
    "../llm-harness-plugins/session-lifecycle/opencode/index.ts",
    "../llm-harness-plugins/agentmem/opencode/index.ts",
    "../llm-harness-plugins/semantic-cache/opencode/index.ts",
    "../llm-harness-plugins/tier-router/opencode/index.ts",
    "../llm-harness-plugins/datetime-inject/opencode/index.ts",
    "../llm-harness-plugins/offpeak-nudge/opencode/index.ts",
    "../llm-harness-plugins/agentinsights/opencode/index.ts",
    "../llm-harness-plugins/graphrag/opencode/index.ts",
    "../llm-harness-plugins/knowledge-graph/opencode/index.ts",
    "../llm-harness-plugins/prompt-registry/opencode/index.ts",
    "../llm-harness-plugins/typst-toolkit/opencode/index.ts",
    "../llm-harness-plugins/latex-toolkit/opencode/index.ts",
    "../llm-harness-plugins/java-toolkit/opencode/index.ts",
    "../llm-harness-plugins/python-toolkit/opencode/index.ts",
    "../llm-harness-plugins/ivp/opencode/index.ts",
    "../llm-harness-plugins/general-skills/opencode/index.ts",
    "../llm-harness-plugins/permission-modes/opencode/index.ts",
    "../llm-harness-plugins/agentfeed/opencode/index.ts",
    "../llm-harness-plugins/natural-prose/opencode/index.ts",
    "../llm-harness-plugins/codify-first/opencode/index.ts",
    "../llm-harness-plugins/system-message-merge/opencode/index.ts",
    "../llm-harness-plugins/scientific-writing/opencode/index.ts",
    "../llm-harness-plugins/premium-read-offload/opencode/index.ts"
  ],
  "agent": {
    "backward-reader-auditor": {
      "description": "Adversarial auditor that reads from conclusions/theorems backward to premises — catches results that depend on unstated lemmas, hand-waved steps, or support chains with missing links. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/backward-reader-auditor.md}"
    },
    "benefit-navigator": {
      "model": "proxy/warrant-officer"
    },
    "bibliography-auditor": {
      "description": "Audit bibliography files and citation usage for duplicates, missing fields, broken citations, uncited entries, and retracted papers.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/general-skills/agents/bibliography-auditor.md}"
    },
    "biochemistry-auditor": {
      "model": "proxy/warrant-officer"
    },
    "biomarker-auditor": {
      "model": "proxy/warrant-officer"
    },
    "caregiver-coordinator": {
      "model": "proxy/warrant-officer"
    },
    "case-documenter": {
      "model": "proxy/warrant-officer"
    },
    "causal-model-builder": {
      "model": "proxy/lieutenant"
    },
    "changelog-generator": {
      "model": "proxy/warrant-officer"
    },
    "chapter-inserter": {
      "model": "proxy/warrant-officer"
    },
    "ci-build-fixer": {
      "model": "proxy/warrant-officer"
    },
    "citation-fidelity-auditor": {
      "description": "Verify that cited sources actually support the claims they back — catches misrepresented sources, cherry-picked quotations, and scope mismatches.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/general-skills/agents/citation-fidelity-auditor.md}"
    },
    "claim-substance-auditor": {
      "description": "Audit formal claims (theorems, corollaries, propositions) for substantive content — catches tautologies, circular conclusions, vacuous preconditions, and claims that merely restate definitions or axioms without adding insight. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/claim-substance-auditor.md}"
    },
    "clinician-auditor": {
      "model": "proxy/warrant-officer"
    },
    "commit-writer": {
      "model": "proxy/warrant-officer"
    },
    "common-error-claim-auditor": {
      "description": "Detects prose claims about errors/interpretations/consequences that \"people/practitioners often do/see,\" and practice-grounding claims (\"In practice...\", \"Usually...\", \"Experience shows...\") that assert accumulated experience as evidence. New or novel concepts require no such history and such claims are suspect; preexisting concepts require citations or careful hedging. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/common-error-claim-auditor.md}"
    },
    "comorbidity-auditor": {
      "model": "proxy/warrant-officer"
    },
    "config-auditor": {
      "description": "Audit AI coding agent configuration stacks for conflicts, inconsistencies, or undefined references across config files, agents, and workflows.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/general-skills/agents/config-auditor.md}"
    },
    "config-optimizer": {
      "model": "proxy/warrant-officer"
    },
    "content-reviewer": {
      "model": "proxy/warrant-officer"
    },
    "content-splitter": {
      "description": "Split a monolithic Typst file into the canonical content hierarchy (part/chapter/section/subsection + typed subdirs per environment). Reads the global content-structure-convention.md. Iso-functional operation — all post-conditions must hold after split. Use when a chapter or section file contains prose and environment instances that should be extracted into typed subdirectory files.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/typst-toolkit/agents/content-splitter.md}"
    },
    "crisis-manager": {
      "model": "proxy/lieutenant"
    },
    "cynic-auditor": {
      "description": "Adversarial reviewer who assumes the worst about every claim — looks for motivated reasoning, cherry-picking, confirmation bias, and arguments that are technically true but misleading. The hostile reviewer who thinks a document is advocacy disguised as science. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/cynic-auditor.md}"
    },
    "data-validator": {
      "model": "proxy/warrant-officer"
    },
    "definition-auditor": {
      "description": "Audit formal definitions for rigor, circularity, undefined terms, ambiguity, and rootedness in the theory's primitives. Ensures definitions form a well-founded hierarchy traceable to the axiomatic foundation.",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/definition-auditor.md}"
    },
    "definition-use-checker": {
      "description": "Verify every formal term is defined before first use (definitions, axioms, notation appear before prose/proof/example references).",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/definition-use-checker.md}"
    },
    "devil-advocate-auditor": {
      "description": "Adversarial reviewer who systematically constructs the strongest possible counter-argument to every major claim — not to disprove the work, but to identify which claims can withstand the strongest opposition and which cannot. The reviewer who asks \"what's the best argument AGAINST this?\" Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/devil-advocate-auditor.md}"
    },
    "diagram-accuracy-auditor": {
      "model": "proxy/warrant-officer-v"
    },
    "diagram-consistency-auditor": {
      "model": "proxy/warrant-officer-v"
    },
    "diagram-rhetoric-auditor": {
      "model": "proxy/lieutenant-v"
    },
    "dictionary-manager": {
      "model": "proxy/sergeant"
    },
    "document-health-monitor": {
      "description": "Generate structural health metrics for a document — section lengths, citation density, empty-section detection, placeholder identification. Use when checking document balance, finding stub sections, or assessing how complete a document skeleton is. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/document-health-monitor.md}"
    },
    "driver-assignment-auditor": {
      "description": "Adversarially audit a change-driver registry and its element→driver assignments for IVP soundness — proxy grounding, missed drivers, conflation, admissibility violations, unanchored drivers. Read-only; reports findings only.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/ivp/agents/driver-assignment-auditor.md}"
    },
    "driver-identifier": {
      "description": "Review all code elements in scope, identify their change drivers, and write the change-driver registry into the codebase's native doc convention (Javadoc/docblock). Read-mostly; edits only the driver registry.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/ivp/agents/driver-identifier.md}"
    },
    "english-prose-pattern-auditor": {
      "model": "proxy/second-lieutenant"
    },
    "epc-model-builder": {
      "model": "proxy/lieutenant"
    },
    "epidemiology-auditor": {
      "model": "proxy/warrant-officer"
    },
    "evidence-mapper": {
      "model": "proxy/warrant-officer"
    },
    "falsifiability-auditor": {
      "description": "Audit hypothesis/speculation environments for falsifiable predictions, claim-registry consistency, competing hypotheses, and overclaiming language. Use when checking the intellectual rigor of scientific claims. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/falsifiability-auditor.md}"
    },
    "falsificationist-auditor": {
      "description": "Adversarial auditor adopting the Popperian philosophy of science — checks whether a theory states its falsifiability conditions, whether its claims are testable, and whether the theory could in principle be shown wrong. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/falsificationist-auditor.md}"
    },
    "figure-caption-auditor": {
      "model": "proxy/sergeant"
    },
    "file-splitter": {
      "model": "proxy/warrant-officer"
    },
    "formalization-advisor": {
      "model": "proxy/lieutenant"
    },
    "formatting-fixer": {
      "model": "proxy/sergeant"
    },
    "functional-paradigm-auditor": {
      "description": "Adversarial auditor adopting the persona of a functional programming practitioner — catches implicit OOP assumptions, paradigm-specific examples presented as universal, and gaps in a document's applicability to non-OO paradigms. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/functional-paradigm-auditor.md}"
    },
    "gamma-modularizer": {
      "description": "Sort code elements into modules by gamma-equivalence — group elements with identical change-driver sets into the same module, split elements with different driver sets apart. Edits module boundaries, not driver assignments.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/ivp/agents/gamma-modularizer.md}"
    },
    "git-historian": {
      "model": "proxy/warrant-officer"
    },
    "haiku-general": {
      "description": "Fast, cost-effective agent for mechanical tasks with no specialized agent available. Use when task requires speed over reasoning and involves no judgment calls or significant consequences. Explicit file paths required for modifications.",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/tier-router/agents/haiku-general.md}"
    },
    "hypothesis-compatibility-auditor": {
      "model": "proxy/lieutenant"
    },
    "hypothesis-generator": {
      "model": "proxy/warrant-officer"
    },
    "hypothesis-registry-updater": {
      "model": "proxy/sergeant"
    },
    "hypothesis-reinforcement-builder": {
      "model": "proxy/lieutenant"
    },
    "immunology-auditor": {
      "model": "proxy/warrant-officer"
    },
    "index-auditor": {
      "model": "proxy/warrant-officer"
    },
    "industry-architect-auditor": {
      "description": "Adversarial auditor adopting the persona of a senior software architect with 15+ years of production experience — catches theory that never lands practically, missing decision procedures, and gaps between formal results and actionable guidance. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/industry-architect-auditor.md}"
    },
    "ivp-refactor-auditor": {
      "description": "Verify a post-modularization codebase against the four IVP conditions — Separation, Unification, Admissibility, Element Form — and nesting soundness. Read-only; reports violations only.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/ivp/agents/ivp-refactor-auditor.md}"
    },
    "latex-citation-checker": {
      "description": "Verify all LaTeX citations are valid, find undefined citations, check bibliography consistency.",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/latex-toolkit/agents/latex-citation-checker.md}"
    },
    "latex-figure-caption-auditor": {
      "description": "Audit LaTeX figure/table captions — must state a claim, be standalone-readable, have labels, and be referenced in text.",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/latex-toolkit/agents/latex-figure-caption-auditor.md}"
    },
    "latex-formatting-fixer": {
      "description": "Convert Markdown formatting to LaTeX and normalize formatting conventions.",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/latex-toolkit/agents/latex-formatting-fixer.md}"
    },
    "latex-index-auditor": {
      "description": "Audit \\index coverage — verify key terms, theorems, definitions, and named concepts are indexed, and index entries are consistent.",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/latex-toolkit/agents/latex-index-auditor.md}"
    },
    "latex-notation-consistency-checker": {
      "description": "Audit LaTeX source files for notation consistency against a notation reconciliation document. Catch symbol drift across files.",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/latex-toolkit/agents/latex-notation-consistency-checker.md}"
    },
    "latex-production-readiness-checker": {
      "description": "Scan LaTeX files for TODO markers, placeholders, debug artifacts, draft mode, and production issues.",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/latex-toolkit/agents/latex-production-readiness-checker.md}"
    },
    "latex-syntax-fixer": {
      "description": "Fix LaTeX compilation errors and warnings. Use when LaTeX build fails.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/latex-toolkit/agents/latex-syntax-fixer.md}"
    },
    "latex-xref-checker": {
      "description": "Verify all LaTeX cross-references (\\ref, \\cref, \\pageref, \\autoref, \\nameref, \\eqref) resolve within and across files.",
      "mode": "subagent",
      "model": "proxy/sergeant",
      "prompt": "{file:../llm-harness-plugins/latex-toolkit/agents/latex-xref-checker.md}"
    },
    "link-checker": {
      "model": "proxy/sergeant"
    },
    "literature-integrator": {
      "model": "proxy/warrant-officer"
    },
    "logic-auditor": {
      "description": "Audit document for circular reasoning, completeness gaps, hidden assumptions, forward references, and ambiguous statements.",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/general-skills/agents/logic-auditor.md}"
