      "model": "proxy/lieutenant"
    },
    "medication-differential-analyst": {
      "model": "proxy/lieutenant"
    },
    "meta-analysis-coordinator": {
      "model": "proxy/warrant-officer"
    },
    "microbiome-auditor": {
      "model": "proxy/warrant-officer"
    },
    "misconception-auditor": {
      "description": "Verify chapters include explicit misconception inoculation — common misunderstandings anticipated and addressed, not left for readers to stumble into.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/misconception-auditor.md}"
    },
    "model-auditor": {
      "model": "proxy/lieutenant"
    },
    "model-integrator": {
      "model": "proxy/warrant-officer"
    },
    "natural-prose-auditor": {
      "file": "../llm-harness-plugins/natural-prose/agents/natural-prose-auditor.md",
      "mode": "subagent"
    },
    "natural-prose-naturalizer": {
      "file": "../llm-harness-plugins/natural-prose/agents/natural-prose-naturalizer.md",
      "mode": "subagent"
    },
    "natural-prose-perplexity-judge": {
      "file": "../llm-harness-plugins/natural-prose/agents/natural-prose-perplexity-judge.md",
      "mode": "subagent"
    },
    "nest-decider": {
      "description": "Decide whether module pairs are siblings or parent/child (nested) modules, using the rule Gamma(P) strictly subset Gamma(C), with a reducibility guard that forbids force-splitting pure or irreducible-composite elements. Read-only; recommends structure.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/ivp/agents/nest-decider.md}"
    },
    "neuro-auditor": {
      "model": "proxy/warrant-officer"
    },
    "notation-consistency-checker": {
      "model": "proxy/sergeant"
    },
    "opus-general": {
      "description": "High-capability agent for complex reasoning tasks with no specialized agent available. Use when task requires deep analysis beyond Sonnet's capabilities — mathematical proofs, sophisticated logical verification, detecting subtle flaws, or high-stakes decisions where errors would be very costly.",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/tier-router/agents/opus-general.md}"
    },
    "pacing-coach": {
      "model": "proxy/warrant-officer"
    },
    "pathway-auditor": {
      "model": "proxy/warrant-officer"
    },
    "patient-safety-auditor": {
      "model": "proxy/lieutenant"
    },
    "pharmacology-auditor": {
      "model": "proxy/warrant-officer"
    },
    "production-readiness-checker": {
      "model": "proxy/sergeant"
    },
    "proof-soundness-auditor": {
      "description": "Deep adversarial review of formal proofs for logical soundness, hidden assumptions, gap detection, and circularity.",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/general-skills/agents/proof-soundness-auditor.md}"
    },
    "protocol-linker": {
      "model": "proxy/warrant-officer"
    },
    "publication-preparer": {
      "model": "proxy/warrant-officer"
    },
    "quantitative-model-builder": {
      "model": "proxy/lieutenant"
    },
    "reductionist-auditor": {
      "description": "Adversarial reviewer who attacks complexity and integration claims — finds where multi-system explanations are asserted without rigorous justification, where Occam's razor would prefer simpler explanations, and where \"everything is connected\" substitutes for actual mechanistic evidence. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/reductionist-auditor.md}"
    },
    "redundancy-auditor": {
      "description": "Detect repeated statements, arguments, and conclusions across documents. Paragraph-level semantic redundancy analysis.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/general-skills/agents/redundancy-auditor.md}"
    },
    "release-manager": {
      "model": "proxy/warrant-officer"
    },
    "research-gap-synthesizer": {
      "model": "proxy/warrant-officer"
    },
    "research-monitor": {
      "model": "proxy/warrant-officer"
    },
    "safety-auditor": {
      "model": "proxy/lieutenant"
    },
    "scenario-validity-auditor": {
      "description": "Audit examples and case discussions for scenario validity — catches scenarios that fail to exhibit the pitfall or principle they claim to illustrate, cases where the \"wrong\" design is actually correct application of the text's own principles, cases where the \"correct\" design smuggles in the same errors the text flags elsewhere, and cases where the concrete story contradicts the abstract claim. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/scenario-validity-auditor.md}"
    },
    "scientific-insight-generator": {
      "model": "proxy/lieutenant"
    },
    "scientific-rigor-auditor": {
      "model": "proxy/warrant-officer"
    },
    "scope-qualifier-checker": {
      "description": "Verify that claims and advice explicitly state their level of applicability — class-level vs module-level vs system-level, paradigm scope, technology context, and temporal validity.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/scope-qualifier-checker.md}"
    },
    "skimmer-auditor": {
      "description": "Adversarial auditor adopting the persona of a reader who only reads headings, first/last sentences, figures, boxed environments, and highlighted text — catches key points buried in paragraphs rather than surfaced structurally. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/skimmer-auditor.md}"
    },
    "sonnet-general": {
      "description": "Balanced agent for general tasks with no specialized agent available. Use when task requires reasoning, analysis, judgment calls, or assessing trade-offs. Default choice for non-specialized work. Handles multi-step planning, cross-referencing, and coordination.",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/tier-router/agents/sonnet-general.md}"
    },
    "sophist-attacker": {
      "description": "Adversarial auditor that deliberately misreads claims, exploits ambiguous wording, constructs strawmen from loose phrasing, and deploys rhetorical fallacies — forces the text to be airtight against motivated misinterpretation by hostile commenters, blog posts, and conference hallway attacks. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/warrant-officer",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/sophist-attacker.md}"
    },
    "sophist-auditor": {
      "description": "Adversarial reviewer who attacks the logical structure of arguments — finds non sequiturs, equivocation, false dichotomies, argument from authority, and rhetorical tricks that substitute for actual reasoning. The reviewer who ignores what you meant and attacks what you actually wrote. Format-agnostic (Typst or LaTeX).",
      "mode": "subagent",
      "model": "proxy/lieutenant",
      "prompt": "{file:../llm-harness-plugins/scientific-writing/agents/sophist-auditor.md}"
    },
    "ste-100-auditor": {
