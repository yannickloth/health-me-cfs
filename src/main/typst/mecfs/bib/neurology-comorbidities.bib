@article{Peng2026NeurogenesisNatureMed,
  title = {Dysregulated adult hippocampal neurogenesis in major depressive disorders},
  author = {Peng, Madeleine S. and Jiang, Jialin and Polizzi, Lucia and Shi, Tiancheng and Ramkumar, Rakshitha and Anosike, Victor O. and Guasoni, Giulia and Wamalwa, Alexandra M. and Mariani, Madeline B. and Sissoko, Cheick A. and Tartt, Alexandria N. and Fulmore, Camille and Rosoklija, Gorazd B. and Huang, Yung-yu and Arango, Victoria and McDonald, Shujuan T. and Bitoljanu, Natasha and Mann, J. John and Nguyen, Phi T. and Dwork, Andrew J. and Brown, Lewis M. and Hen, René and Galfalvy, Hanga and Dupont, Maura B.},
  journal = {Nature Medicine},
  year = {2026},
  volume = {32},
  doi = {10.1038/s41591-026-04571-8},
  url = {https://www.nature.com/articles/s41591-026-04571-8},
  note = {PRIMARY PAPER. Single-nucleus RNA + ATAC (snMultiome), spatial transcriptomics, and regional proteomics on ~500,000 nuclei from hippocampus (DG and CA) of 11 nonmedicated MDD vs 19 control individuals. Identifies an adult human hippocampal neurogenic lineage (NSCa/NSCb -> INP -> NB -> ImGC) and evidence of STALLED neurogenesis in MDD (more NSCa, fewer NBs; reduced nestin/Ki67/DCX). Molecular findings: trisynaptic circuit (DG + CA) shows disrupted excitatory-inhibitory balance, impaired synaptic plasticity and neurotransmission, cellular stress, impaired intracellular trafficking, serotonergic/glutamatergic dysfunction, reduced metabolic capacity, and neuroinflammation (interferon signaling module upregulated in early neurogenic stages). Some dysregulated genes carry MDD-associated GWAS variants, others are epigenetically regulated. Overlapping pathogenetic mechanisms with autoimmune, neurodevelopmental, and neurodegenerative diseases. Suggests reclassifying depression by molecular features (analogous to cancer). Pattern separation (a hippocampal function dependent on AHN) impaired in depression, per mouse evidence and radiation-ablation data in brain-tumor patients. Population weight 1.0 (direct human MDD post-mortem; foundational for topic).},
  keywords = {adult hippocampal neurogenesis, depression, MDD, single-nucleus, neurogenesis, hippocampus, trisynaptic circuit, neuroinflammation},
  research_stream = {depression-hippocampal-neurogenesis},
  certainty = {0.80}
}

