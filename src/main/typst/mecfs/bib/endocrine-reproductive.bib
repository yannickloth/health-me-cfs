@article{Adkisson2014hyperpara,
  author       = {Adkisson, Cameron D and Yip, Linwah and Armstrong, Michaele J and Stang, Michael T and Carty, Sally E and McCoy, Kelly L},
  title        = {Fibromyalgia symptoms and medication requirements respond to parathyroidectomy},
  journal      = {Surgery},
  year         = {2014},
  volume       = {156},
  number       = {6},
  pages        = {1614--1620},
  doi          = {10.1016/j.surg.2014.08.063},
  pmid         = {25456962},
  url          = {https://doi.org/10.1016/j.surg.2014.08.063},
  keywords     = {hyperparathyroidism, fibromyalgia, parathyroidectomy, fatigue, cognitive, treatment response, differential diagnosis},
  note         = {Retrospective cohort of 2184 sporadic primary hyperparathyroidism patients who had parathyroidectomy; 80 (4%) had a prior fibromyalgia diagnosis. 97.3% achieved cure (normocalcemia >=6 months). After PTX, 89% had improvement in >=1 FM-attributed symptom; improved cognition/memory most common (80%). Narcotic use down in 77%, anti-inflammatories 74%, FM-specific meds 33%, antidepressants 30%; 21% discontinued all FM meds. Conclusion: before diagnosing FM, providers should exclude PHPT, which is surgically correctable. Directly supports the endocrine-exclusion requirement.},
  research_stream = {hyperparathyroidism-differential},
  certainty    = {0.70}
}

