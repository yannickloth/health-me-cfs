@article{Mairinger2026hyperpara,
  author       = {Mairinger, M and Godbersen, GM and Kasper, S},
  title        = {Neuropsychiatric manifestations of primary hyperparathyroidism},
  journal      = {Wiener klinische Wochenschrift},
  year         = {2026},
  volume       = {138},
  number       = {7-8},
  pages        = {232--240},
  doi          = {10.1007/s00508-025-02688-3},
  pmid         = {41504896},
  url          = {https://doi.org/10.1007/s00508-025-02688-3},
  keywords     = {hyperparathyroidism, neuropsychiatric, fatigue, cognitive, depression, anxiety, review},
  note         = {Narrative review. Neuropsychiatric manifestations occur in ~25% of patients with primary hyperparathyroidism. Symptoms range from depression, anxiety, fatigue and cognitive dysfunction (common) to mania, delirium, psychosis (rare). Proposed multifactorial pathophysiology: elevated PTH and hypercalcemia with effects on monoamine neurotransmission and neuroinflammation (monoamine oxidase, tyrosine hydroxylase, Na+/K+ ATPase, IL-6). Documents that fatigue and cognitive symptoms overlap those of ME/CFS, supporting hyperparathyroidism as a differential to exclude.},
  research_stream = {hyperparathyroidism-differential},
  certainty    = {0.50}
}

@article{Koman2022hyperpara,
  author       = {Koman, A and Br{\"a}ström, R and Pernow, Y and Br{\"a}ström, R and Nilsson, IL and Granath, F},
  title        = {Neuropsychiatric Comorbidity in Primary Hyperparathyroidism Before and After Parathyroidectomy: A Population Study},
  journal      = {World Journal of Surgery},
  year         = {2022},
  volume       = {46},
  number       = {6},
  pages        = {1420--1430},
  doi          = {10.1007/s00268-022-06485-1},
  pmid         = {35246714},
  pmcid        = {PMC9054898},
  url          = {https://doi.org/10.1007/s00268-022-06485-1},
  keywords     = {hyperparathyroidism, neuropsychiatric, depression, parathyroidectomy, population study},
  note         = {Population study: 8279 PHPT patients treated with parathyroidectomy in Sweden vs 82,790 matched controls. Pre-PTX, PHPT patients used significantly more antidepressants, anxiolytics and sleep medication (benzodiazepines OR 1.40, 95% CI 1.31-1.50; SSRIs OR 1.38, 95% CI 1.30-1.47). Postoperatively the excess anxiolytic benzodiazepine use fell (30% to 19%) and sleep benzodiazepines (31% to 14%), but no decrease for SSRIs. Confirms neuropsychiatric (depression/anxiety) comorbidity in PHPT, relevant to the symptom overlap with ME/CFS and the reversibility of some symptoms with surgery.},
  research_stream = {hyperparathyroidism-differential},
  certainty    = {0.70}
}

@article{ObergerMarques2020hyperpara,
  author       = {Oberger Marques, Joao Vitor and Moreira, Carolina Aguiar},
  title        = {Primary hyperparathyroidism},
  journal      = {Best Practice & Research Clinical Rheumatology},
  year         = {2020},
  volume       = {34},
  number       = {3},
  pages        = {101514},
  doi          = {10.1016/j.berh.2020.101514},
  pmid         = {32336576},
  url          = {https://doi.org/10.1016/j.berh.2020.101514},
  keywords     = {hyperparathyroidism, review, rheumatology, muscle weakness, calcium, diagnosis},
  note         = {Review in a rheumatology journal. PHPT causes hypercalcemia from PTH hypersecretion. Manifestations: bone pain, fractures, nephrolithiasis, muscle weakness (symptomatic disease) but now mostly asymptomatic (80-90%). Atypical manifestations include neuropsychiatric/cognitive, neuromuscular, rheumatological and gastrointestinal. Diagnosis usually from routine calcium measurement showing high total calcium with high or inappropriately normal PTH. Relevant to the differential-diagnosis requirement because PHPT causes fatigue, muscle weakness and rheumatological symptoms that overlap ME/CFS.},
  research_stream = {hyperparathyroidism-differential},
  certainty    = {0.50}
}

@article{Wootton2026hyperpara,
  author       = {Wootton, E and De Sousa, SMC and Prince, RL and McLeod, DSA and Pattison, DA and Grossmann, M},
  title        = {Primary Hyperparathyroidism in Adults: Recent Developments in Diagnosis and Management},
  journal      = {Medical Journal of Australia},
  year         = {2026},
  volume       = {224},
  number       = {5},
  pages        = {e70194},
  doi          = {10.5694/mja2.70194},
  pmid         = {42132449},
  url          = {https://doi.org/10.5694/mja2.70194},
  keywords     = {hyperparathyroidism, diagnosis, management, calcium, parathyroid hormone, review},
  note         = {Review of PHPT diagnosis and management. Prevalence ~1% in the general population. Diagnosis requires biochemical testing of serum calcium and PTH plus urine calcium, and screening for complications including osteoporosis, renal disease, abdominal symptoms and neuropsychiatric disturbance. Up to 10% have hereditary PHPT (genetic testing consideration). Surgery is curative. Notes the diagnosis of non-classical manifestations (including neuropsychiatric) carries uncertainty. Provides the diagnostic workup basis for the exclusion requirement (serum calcium + PTH).},
  research_stream = {hyperparathyroidism-differential},
  certainty    = {0.50}
}

@article{Liu2021hyperpara,
  author       = {Liu, Jessica Y and Peine, Brandon S and Mlaver, Eli and Patel, Snehal G and Weber, Collin J and Saunders, Neil D and Pofahl, Walter E and Sharma, Jyotirmay},
  title        = {Neuropsychologic changes in primary hyperparathyroidism after parathyroidectomy from a dual-institution prospective study},
  journal      = {Surgery},
  year         = {2021},
  volume       = {169},
  number       = {1},
  pages        = {114--119},
  doi          = {10.1016/j.surg.2020.06.006},
  pmid         = {32718801},
  url          = {https://doi.org/10.1016/j.surg.2020.06.006},
  keywords     = {hyperparathyroidism, parathyroidectomy, depression, anxiety, neuropsychiatric, treatment outcome},
  note         = {Dual-institution prospective study: 244 parathyroidectomy patients vs 161 thyroidectomy controls. Neuropsychiatric symptoms improved after parathyroidectomy (6.2 [5.0-7.4], P<0.01). Preoperatively neuropsychiatric symptoms more prevalent in PTX vs thyroidectomy groups (11.2 +/- 11.5 vs 7.5 +/- 8.2, P<0.01); postoperatively no difference (5.1 +/- 7.1 vs 5.4 +/- 7.2, P=0.59). Moderate-severe depression fell from 27.5% to 8.2% and anxiety from 18.0% to 5.3% (both P<0.01). Conclusion: assess neuropsychiatric symptoms in all PHPT patients; consider them a relative indication for PTX. Supports the argument that reversible fatigue/cognitive symptoms of HPT can mimic ME/CFS.},
  research_stream = {hyperparathyroidism-differential},
  certainty    = {0.70}
}
