@misc{Charlton2026SCdepletion,
  author        = {Charlton, Braeden T. and Slaghekke, Anouk and Huijts, Jelle Y. and Appelman, Brent and Chen, P. L. and Goulding, Richie P. and Bloemers, Frank W. and Posthuma, Jelle J. and van Amstel, Peter and Noort, Wendy and Jaspers, Richard T. and van Vugt, Mich{\`e}le and W{\"u}st, Rob C. I.},
  title         = {An Inability to Recover: {Reduced} Regenerative Markers and Altered Metabolism in Patients with {ME/CFS} and {Long COVID}},
  howpublished  = {AMS 2026 Conference, Abstract C14},
  year          = {2026},
  month         = {June},
  note          = {Conference abstract. Vastus lateralis biopsies from n=26 ME/CFS, n=25 LC, n=30 healthy controls. Reduced Pax7+ satellite cells (P<0.001); trending reduced PDGFR$\alpha$+ FAP cells (P=0.061); SC count correlated with OXPHOS capacity (r=0.43, P=0.0035); metabolic shift away from oxidative metabolism; reduced antioxidative metabolites. SAME COHORT as Charlton 2025 medRxiv + Slaghekke 2026 AMS F5. PI: Rob W\"ust, Vrije Universiteit Amsterdam. First direct measurement of satellite cell depletion in ME/CFS/LC.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.40},
  diagnostic_criteria = {custom}
}

@article{Hejbol2022myopathy,
  author        = {Hejb{\o}l, Eva K. and Harbo, Thomas and Agergaard, Jane and Madsen, Louise B. and Pedersen, Thomas H. and {\O}stergaard, Lars J. and Tankisi, Hatice and Schr{\o}der, Henrik D.},
  title         = {Myopathy as a Cause of Fatigue in Long-Term Post-{COVID-19} Symptoms: {Evidence} of Skeletal Muscle Histopathology},
  journal       = {European Journal of Neurology},
  year          = {2022},
  volume        = {29},
  number        = {9},
  pages         = {2832--2841},
  doi           = {10.1111/ene.15435},
  pmid          = {35661354},
  pmcid         = {PMC9348124},
  note          = {Muscle biopsy (n=14 LC with fatigue, m. vastus lateralis) vs n=6 HC. 71\% showed fiber atrophy; 57\% showed fiber type grouping; 43\% showed signs of muscle regeneration (split fibers, central nuclei). Type II fiber predominance in 36\%. Consistent with repeated cycles of damage and incomplete repair. First post-COVID muscle histopathology study.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.60},
  diagnostic_criteria = {custom}
}

@article{Gerwyn2017muscleFatigue,
  author        = {Gerwyn, Morris and Maes, Michael},
