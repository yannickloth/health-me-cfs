@article{Nilsson2020NoMitoAb,
  author        = {Nilsson, Ida and Palmer, Jeremy and Apostolou, Eirini and Gottfries, Carl G. and Rizwan, Muhammad and Dahle, Charlotte and Ros\'{e}n, Anders},
  title         = {Metabolic Dysfunction in {Myalgic Encephalomyelitis/Chronic Fatigue Syndrome} Not Due to Anti-Mitochondrial Antibodies},
