@article{Mughal20253dMuscleSera,
  author        = {Mughal, Sheeza and And\'{u}jar-S\'{a}nchez, F\'{e}lix and Sabater-Arcis, Maria and Garrabou, Gl\`{o}ria and Fern\'{a}ndez-Sol\`{a}, Joaquim and Alegre-Martin, Jose and Sanmartin-Senta\~{n}es, Ramon and Castro-Marrero, Jes\'{u}s and Esteve-Codina, Anna and Casals, Eloi and Fern\'{a}ndez-Costa, Juan M. and Ram\'{o}n-Azc\'{o}n, Javier},
  title         = {Metabolic Adaptation and Fragility in Healthy {3D} In Vitro Skeletal Muscle Tissues Exposed to Chronic Fatigue Syndrome and {Long COVID-19} Sera},
  journal       = {Biofabrication},
  year          = {2025},
  volume        = {17},
  number        = {4},
  doi           = {10.1088/1758-5090/adf66c},
  pmid          = {40744071},
  note          = {First 3D biofabricated skeletal muscle model exposed to ME/CFS and Long COVID patient sera. Short exposure (48h): reduced contractile strength, upregulated glycolysis, mitochondrial hyperfusion, myotube hypertrophy. Prolonged exposure (96--144h): muscle fragility, toroidal mitochondrial fragmentation. Proposed hypermetabolic adaptation $\Rightarrow$ deterioration model. Barcelona mega-collaboration (IBEC, IDIBAPS, Clinic, Vall d'Hebron, CNAG).},
  research_stream = {biofabrication-mughal-3d-muscle-cfs-sera},
  certainty       = {0.26}
}

@article{Appelman2024MusclePEM,
  author        = {Appelman, Brent and Charlton, Braeden T. and Goulding, Richie P. and Kerkhoff, Tom J. and Breedveld, Ellen A. and Noort, Wendy and Offringa, Carla and Bloemers, Frank W. and van Weeghel, Michel and Schomakers, Bauke V. and Coelho, Pedro and Posthuma, Jelle J. and Aronica, Eleonora and Joost Wiersinga, W. and van Vugt, Mich\`{e}le and W\"{u}st, Rob C. I.},
  title         = {Muscle Abnormalities Worsen After Post-Exertional Malaise in Long {COVID}},
  journal       = {Nature Communications},
  year          = {2024},
  volume        = {15},
  pages         = {17},
  doi           = {10.1038/s41467-023-44432-3},
  pmid          = {38177128},
  note          = {Longitudinal case-control (NCT05225688): n=25 Long COVID vs n=21 HC. Skeletal muscle biopsies pre/post maximal exercise. Lower exercise capacity, metabolic disturbances, severe exercise-induced myopathy with amyloid-containing deposits infiltrating skeletal muscle after PEM. Glycolytic fiber type shift. W\"ust lab, Amsterdam.},
  research_stream = {biofabrication-mughal-3d-muscle-cfs-sera},
  certainty       = {0.68}
}

@article{Appelman2025ReplyMuscle,
  author        = {Appelman, Brent and Charlton, Braeden T. and Goulding, Richie P. and Kerkhoff, Tom J. and Breedveld, Ellen A. and Noort, Wendy and Offringa, Carla and Bloemers, Frank W. and van Weeghel, Michel and Schomakers, Bauke V. and Coelho, Pedro and Posthuma, Jelle J. and Aronica, Eleonora and Wiersinga, W. Joost and van Vugt, Mich\`{e}le and W\"{u}st, Rob C. I.},
  title         = {Reply: Muscle Abnormalities in Long {COVID}},
  journal       = {Nature Communications},
  year          = {2025},
  volume        = {16},
  pages         = {1491},
  doi           = {10.1038/s41467-025-56431-7},
  note          = {Matters Arising reply to Ranque et al. (2025). Refutes deconditioning interpretation of Long COVID muscle abnormalities. Key rebuttal specifics: matched step-count (5181 vs 4727 steps/day patients/controls) still shows -24% VO2max (p=0.004) and -31% peak power (p=0.043); reduced gas exchange threshold and respiratory compensation point are effort-independent; intrinsic mitochondrial respiration reduced (qualitative, not mitochondrial content loss as in bed rest); no capillary/fibre CSA differences vs controls (unlike bed rest); GET meta-analyses (Larun 2017, REGAIN 2024, Espinoza-Bravo 2023, Jimeno-Almazan 2022) include comorbidity-confounded participants; Walitt et al. (2024) deep phenotyping supports physiological (not psychological) PEM explanation. Same W\"ust-lab Amsterdam cohort as Appelman 2024 + Charlton 2026 bed rest.},
  research_stream = {appelman2025-reply-muscle},
  certainty       = {0.68}
}

@article{Fluge2016PDH,
  author        = {Fluge, {\O}ystein and Mella, Olav and Bruland, Ove and Risa, Kristin and Dyrstad, Sissel E. and Alme, Kine and Rekeland, Ingrid G. and Sapkota, Dipak and R{\o}sland, Gro V. and Foss\r{a}, Alexander and Ktoridou-Valen, Irini and Lunde, Sigrid and S{\o}rland, Kari and Lien, Kristin and Herder, Ingrid and Th\"{u}rmer, Hanne and Gotaas, Merete E. and Baranowska, Katarzyna A. and Bohnen, Louis M. and Sch\"{a}fer, Christoph and McCann, Adrian and Sommerfelt, Kristian and Helgeland, Lars and Ueland, Per M. and Dahl, Olav and Tronstad, Karl J.},
  title         = {Metabolic Profiling Indicates Impaired Pyruvate Dehydrogenase Function in Myalgic Encephalopathy/Chronic Fatigue Syndrome},
  journal       = {JCI Insight},
  year          = {2016},
  volume        = {1},
  number        = {21},
  pages         = {e89376},
  doi           = {10.1172/jci.insight.89376},
  pmid          = {28018972},
  note          = {Serum metabolomics n=200 ME/CFS + 102 HC. Specific reduction of TCA-fueling amino acids. PDH impairment via PDK1/2/4 upregulation. Myoblasts grown in severe ME/CFS serum: increased mitochondrial respiration + excessive lactate secretion. First serum-transfer-to-muscle-cell experiment in ME/CFS -- methodological precursor to Mughal 2025.},
  research_stream = {biofabrication-mughal-3d-muscle-cfs-sera},
  certainty       = {0.52}
}

@article{Charlton2025MusclePEMReview,
  author        = {Charlton, Braeden T. and Goulding, Richie P. and Jaspers, Richard T. and Appelman, Brent and van Vugt, Mich\`{e}le and W\"{u}st, Rob C. I.},
