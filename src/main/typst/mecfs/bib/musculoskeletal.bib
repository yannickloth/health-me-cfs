@article{Vecchiet1996muscleCFS,
  author        = {Vecchiet, L. and Montanari, G. and Pizzigallo, E. and Iezzi, S. and de Bigontina, P. and Dragani, L. and Vecchiet, J. and Giamberardino, M. A.},
