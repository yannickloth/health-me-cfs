  certainty       = {0.28}
}

% ── Osteoporosis / bone health (2026-08-29) ─────────────────────

@article{Rolvien2022DisuseOsteoporosis,
  author    = {Rolvien, Tim and Amling, Michael},
  title     = {Disuse Osteoporosis: Clinical and Mechanistic Insights},
  journal   = {Calcified Tissue International},
  year      = {2022},
  volume    = {110},
  number    = {5},
  pages     = {592--604},
  doi       = {10.1007/s00223-021-00836-1},
  pmid      = {33738515},
  pmcid     = {PMC9013332},
  note      = {Clinical and mechanistic review of disuse osteoporosis. Clinical settings include spinal cord injury, other neurological/neuromuscular disorders, immobilization after fractures, and bed rest (real or modeled). Immobilization causes immediate trabecular and cortical bone loss with increased resorption and decreased formation. Low-formation state linked to high sclerostin; osteocytes sense mechanical load via mechanosensors (cytoskeleton, Piezo1 ion channels, primary cilia, integrins, connexin hemichannels). KEY bedrest-precedent: sustained unloading/sedentary low-load directly drives osteoporosis — supports the H1 reduced-mobility risk hypothesis for moderate-severe ME/CFS.},
  keywords  = {disuse osteoporosis, immobilization, bed rest, osteocyte, mechanosensing, sclerostin},
  research_stream = {osteoporosis},
  certainty = {0.78}
}

@article{Qin2013MuscleBone,
  author    = {Qin, Weiping and Sun, Li and Cao, Jing and Peng, Yuanzhen and Collier, Lauren and Wu, Yan and Creasey, Graham and Li, Jia and Qin, Yunqin and Jarvis, James and Bauman, William A and Zaidi, Mone and Cardozo, Christopher},
  title     = {The central nervous system (CNS)-independent anti-bone-resorptive activity of muscle contraction and the underlying molecular and cellular signatures},
  journal   = {Journal of Biological Chemistry},
  year      = {2013},
  volume    = {288},
  number    = {19},
  pages     = {13511--13521},
  doi       = {10.1074/jbc.M113.454892},
  pmid      = {23530032},
  note      = {Animal (SCI rat) model. Electrically stimulated muscle contraction completely reversed the SCI-induced increase in serum CTX (bone resorption marker), reduced osteoclast number, and raised the OPG/RANKL ratio; ES also lowered Wnt inhibitors DKK1, sFRP2, sclerostin. Demonstrates muscle activity suppresses bone resorption independent of the CNS, via mechanical + myokine signals. Maps the RANKL/OPG pathway to inactivity: reduced muscle loading/contraction in deconditioned ME/CFS would shift OPG/RANKL toward resorption.},
  keywords  = {RANKL, OPG, muscle contraction, bone resorption, spinal cord injury, myokine, osteocyte},
  research_stream = {osteoporosis},
  certainty = {0.55}
}

@article{Hart2021Deconditioning,
  author    = {Hart, David A},
  title     = {Learning From Human Responses to Deconditioning Environments: Improved Understanding of the "Use It or Lose It" Principle},
  journal   = {Frontiers in Sports and Active Living},
  year      = {2021},
  volume    = {3},
  pages     = {685845},
  doi       = {10.3389/fspor.2021.685845},
  pmid      = {34927066},
  pmcid     = {PMC8677937},
  note      = {Narrative review of deconditioning (spaceflight, prolonged bedrest, protracted sedentary behavior) and its consequences for musculoskeletal and cardiovascular integrity. Articulates the "use it or lose it" principle: chronic deconditioning poses risk for disease development and progression. Provides the conceptual frame linking prolonged reduced activity in moderate-severe ME/CFS to systemic deconditioning including bone loss.},
  keywords  = {deconditioning, bed rest, inactivity, bone, muscle, physical fitness},
  research_stream = {osteoporosis},
  certainty = {0.55}
}
