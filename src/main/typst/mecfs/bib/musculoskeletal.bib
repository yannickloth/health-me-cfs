@article{FernandezGaribay2022XenoMuscle,
  author        = {Fern\'{a}ndez-Garibay, Xavi and G\'{o}mez-Florit, Manuel and Domingues, Rui M. A. and Gomes, Manuela E. and Fern\'{a}ndez-Costa, Juan M. and Ram\'{o}n-Azc\'{o}n, Javier},
