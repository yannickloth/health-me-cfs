@misc{Charlton2026SCdepletion,
  author        = {Charlton, Braeden T. and Slaghekke, Anouk and Huijts, Jelle Y. and Appelman, Brent and Chen, P. L. and Goulding, Richie P. and Bloemers, Frank W. and Posthuma, Jelle J. and van Amstel, Peter and Noort, Wendy and Jaspers, Richard T. and van Vugt, Mich{\`e}le and W{\"u}st, Rob C. I.},
  title         = {An Inability to Recover: {Reduced} Regenerative Markers and Altered Metabolism in Patients with {ME/CFS} and {Long COVID}},
  howpublished  = {AMS 2026 Conference, Abstract C14},
  year          = {2026},
  month         = {June},
  note          = {Conference abstract. Vastus lateralis biopsies from n=26 ME/CFS, n=25 LC, n=30 healthy controls. Reduced Pax7+ satellite cells (P<0.001); trending reduced PDGFR$\alpha$+ FAP cells (P=0.061); SC count correlated with OXPHOS capacity (r=0.43, P=0.0035); metabolic shift away from oxidative metabolism; reduced antioxidative metabolites. SAME COHORT as Charlton 2025 medRxiv + Slaghekke 2026 AMS F5. PI: Rob W\"ust, Vrije Universiteit Amsterdam. First direct measurement of satellite cell depletion in ME/CFS/LC.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.40},
  diagnostic_criteria = {custom}
}

@article{Hejbol2022myopathy,
  author        = {Hejb{\o}l, Eva K. and Harbo, Thomas and Agergaard, Jane and Madsen, Louise B. and Pedersen, Thomas H. and {\O}stergaard, Lars J. and Tankisi, Hatice and Schr{\o}der, Henrik D.},
  title         = {Myopathy as a Cause of Fatigue in Long-Term Post-{COVID-19} Symptoms: {Evidence} of Skeletal Muscle Histopathology},
  journal       = {European Journal of Neurology},
  year          = {2022},
  volume        = {29},
  number        = {9},
  pages         = {2832--2841},
  doi           = {10.1111/ene.15435},
  pmid          = {35661354},
  pmcid         = {PMC9348124},
  note          = {Muscle biopsy (n=14 LC with fatigue, m. vastus lateralis) vs n=6 HC. 71\% showed fiber atrophy; 57\% showed fiber type grouping; 43\% showed signs of muscle regeneration (split fibers, central nuclei). Type II fiber predominance in 36\%. Consistent with repeated cycles of damage and incomplete repair. First post-COVID muscle histopathology study.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.60},
  diagnostic_criteria = {custom}
}

@article{Gerwyn2017muscleFatigue,
  author        = {Gerwyn, Morris and Maes, Michael},
  title         = {Mechanisms Explaining Muscle Fatigue and Muscle Pain in Patients with {Myalgic Encephalomyelitis/Chronic Fatigue Syndrome} ({ME/CFS}): A Review of Recent Findings},
  journal       = {Current Rheumatology Reports},
  year          = {2017},
  volume        = {19},
  number        = {1},
  pages         = {1},
  doi           = {10.1007/s11926-017-0628-x},
  pmid          = {28116577},
  note          = {Review of oxidative/nitrosative stress and mitochondrial impairments in ME/CFS muscle. Highlights how chronic O\&NS and reduced heat shock protein production impair muscle repair following exercise and adaptive responses to physical activity. Links systemic inflammation to impaired muscle regeneration — relevant to satellite cell dysfunction pathway.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.40}
}

@article{Soares2022muscleCOVID,
  author        = {Soares, Madu N. and Eggelbusch, Morne and Naddaf, Elie and Gerrits, Karin H. L. and van der Schaaf, Marike and van den Borst, Bram and Wiersinga, W. Joost and van Vugt, Mich{\`e}le and Weijs, Peter J. M. and van Gassel, Rob J. J. and J{\"o}rneskog, Gun and Denissen, Karlijn F. M. and W{\"u}st, Rob C. I.},
  title         = {Skeletal Muscle Alterations in Patients with Acute {COVID-19} and Post-Acute Sequelae of {COVID-19}},
  journal       = {Journal of Cachexia, Sarcopenia and Muscle},
  year          = {2022},
  volume        = {13},
  number        = {1},
  pages         = {11--22},
  doi           = {10.1002/jcsm.12872},
  pmid          = {34997689},
  pmcid         = {PMC8818659},
  note          = {Review of skeletal muscle alterations across acute and post-acute COVID-19. Covers muscle atrophy, impaired regenerative capacity, mitochondrial dysfunction, and capillary rarefaction. Part of the same W\"ust-lab research line. Establishes precedent for muscle structural pathology in post-viral syndromes.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.60},
  diagnostic_criteria = {custom}
}

@article{Vecchiet1996muscleCFS,
  author        = {Vecchiet, L. and Montanari, G. and Pizzigallo, E. and Iezzi, S. and de Bigontina, P. and Dragani, L. and Vecchiet, J. and Giamberardino, M. A.},
  title         = {Sensory Characterization of Somatic Parietal Tissues in Humans with Chronic Fatigue Syndrome},
  journal       = {Neuroscience Letters},
  year          = {1996},
  volume        = {208},
  number        = {2},
  pages         = {117--120},
  doi           = {10.1016/0304-3940(96)12559-3},
  pmid          = {8859904},
  note          = {Early CFS muscle biopsy study (n=21 CFS, quadriceps). Found morphostructural alterations: sarcoplasmic fatty degeneration, fibrous regeneration, mitochondrial polymorphism/monstrosity, reduced mitochondrial enzyme activities, and mtDNA common deletion 150--3000$\times$ normal. Selective muscle hyperalgesia (P<0.001) with normal skin/subcutis thresholds. Earliest evidence of disrupted muscle regeneration + mitochondrial pathology in CFS.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.25}
}

@article{Colosio2023musclePASC,
  author        = {Colosio, Matteo and Brocca, Lorenza and Gatti, M. F. and Neri, M. and Crea, E. and Cadile, F. and Canepari, Monica and Pellegrino, M. A. and Polla, Biagio and Bottinelli, Roberto},
  title         = {Structural and Functional Impairments of Skeletal Muscle in Patients with Postacute Sequelae of {SARS}-{CoV}-2 Infection},
  journal       = {Journal of Applied Physiology},
  year          = {2023},
  volume        = {135},
  number        = {4},
  pages         = {902--917},
  doi           = {10.1152/japplphysiol.00119.2023},
  pmid          = {37675472},
  note          = {Vastus lateralis biopsy in n=22 PASC patients vs n=11 controls. Reduced cross-sectional area of type IIx fibers (P=0.02), lower specific force in skinned fibers, preserved mitochondrial respiration. No frank atrophy. Suggests early-stage functional impairment preceding structural degeneration — possibly reflecting inadequate regenerative response.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.55},
  diagnostic_criteria = {custom}
}

@article{Bhattacharya2024SCmetabolic,
  author        = {Bhattacharya, Debashish and Scim{\`e}, Anthony},
  title         = {Metabolic Reprogramming in Skeletal Muscle Stem Cells During Activation and Differentiation},
  journal       = {Skeletal Muscle},
  year          = {2024},
  volume        = {14},
  pages         = {18},
  doi           = {10.1186/s13395-024-00352-2},
  pmid          = {40917051},
  note          = {Review of metabolic switches during satellite cell activation (glycolysis $\rightarrow$ OXPHOS during differentiation). SC activation requires mitochondrial biogenesis; impaired OXPHOS blocks myogenic differentiation. Establishes the SC-OXPHOS dependency that Charlton 2026 (r=0.43 correlation) implicates as a broken mechanism in ME/CFS. Foundational reference for the mitochondrial dependency of muscle stem cell function.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.75}
}

@article{Dumont2015SCbiology,
  author        = {Dumont, Nicolas A. and Bentzinger, C. Florian and Sincennes, Marie-Claude and Rudnicki, Michael A.},
  title         = {Satellite Cells and Skeletal Muscle Regeneration},
  journal       = {Comprehensive Physiology},
  year          = {2015},
  volume        = {5},
  number        = {3},
  pages         = {1027--1059},
  doi           = {10.1002/cphy.c140068},
  pmid          = {26140708},
  note          = {Comprehensive review of satellite cell biology: quiescence, activation, self-renewal, and differentiation. Covers Pax7 as canonical marker, the myogenic regulatory factor cascade (Myf5, MyoD, Myogenin), and SC niche regulation. Foundational reference for interpreting satellite cell depletion in disease context.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.85}
}

@article{Yin2013SCniche,
  author        = {Yin, Hang and Price, Feodor and Rudnicki, Michael A.},
  title         = {Satellite Cells and the Muscle Stem Cell Niche},
  journal       = {Physiological Reviews},
  year          = {2013},
  volume        = {93},
  number        = {1},
  pages         = {23--67},
  doi           = {10.1152/physrev.00043.2011},
  pmid          = {23303905},
  note          = {Authoritative review of satellite cell niche biology. Covers FAP cells (PDGFR$\alpha$+) as niche support cells for SCs, the role of inflammatory signals (TNF$\alpha$, IL-6) in SC activation, and mechanisms of SC depletion with chronic inflammation/oxidative stress. Foundational for understanding how ME/CFS systemic inflammation could drive satellite cell exhaustion.},
  research_stream = {satellite-cell-regeneration},
  certainty       = {0.90}
}
