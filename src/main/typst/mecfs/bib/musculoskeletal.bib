@article{Charlton2026MuscleBedrest,
  author        = {Charlton, Braeden T. and Slaghekke, Anouk and Appelman, Brent and Eggelbusch, Moritz and Huijts, Jelle Y. and Noort, Wendy and Hendrickse, Paul W. and Bloemers, Frank W. and Posthuma, Jelle J. and van Amstel, Paul and Goulding, Richie P. and Degens, Hans and Jaspers, Richard T. and van Vugt, Mich{\`e}le and W{\"u}st, Rob C. I.},
  title         = {Skeletal Muscle Properties in {Long COVID} and {ME/CFS} Differ from Those Induced by Bed Rest},
  journal       = {Nature Communications},
  year          = {2026},
  doi           = {10.1038/s41467-026-75725-y},
  note          = {Landmark comparison: 60d strict bed rest (n=24 healthy) vs long COVID (n\~25), ME/CFS (n\~26), healthy controls (n=30). Both patient groups: more glycolytic fibers vs bed rest; ME/CFS: type I-specific atrophy (not in bed rest or LC); bed rest: muscle atrophy without fiber type change; OXPHOS--VO2max correlation lost in patients; ME/CFS showed lower capillary-to-fiber ratios + capillary density; patients had lower VO2max with unique ventilatory limitation. Concludes physical inactivity alone cannot explain skeletal muscle alterations. SAME COHORT as Appelman 2024 + Charlton 2025 medRxiv. PI: Rob W\"ust, Vrije Universiteit Amsterdam.},
  research_stream = {charlton2026-muscle-bedrest},
  certainty       = {0.85},
  diagnostic_criteria = {Canadian Consensus Criteria}
}

@article{Hendrickse2022CapillaryBR,
  author        = {Hendrickse, Paul W. and W{\"u}st, Rob C. I. and Ganse, Bergita and Giakoumaki, Ifigeneia and Rittweger, J{\"o}rn and Bosutti, Alessandra and Degens, Hans},
  title         = {Capillary Rarefaction During Bed Rest Is Proportionally Less than Fibre Atrophy and Loss of Oxidative Capacity},
  journal       = {Journal of Cachexia, Sarcopenia and Muscle},
  year          = {2022},
  volume        = {13},
  number        = {6},
  pages         = {2712--2723},
  doi           = {10.1002/jcsm.13072},
  pmid          = {36102002},
  pmcid         = {PMC9745458},
  note          = {AGBRESA bed rest cohort (n=19): vastus lateralis + soleus biopsies at baseline, 6d, and 55d bed rest. After 55d, capillary supply was in relative excess of oxidative capacity (+41.9\%). Rapid early fibre atrophy (-23\% at 6d) with proportional capillary loss, followed by disproportionate mitochondrial loss. Artificial gravity (30min/d centrifugation) failed to prevent changes. Foundational for the bed rest comparator in Charlton 2026 -- establishes that bed rest uncouples capillary supply from oxidative capacity.},
  research_stream = {charlton2026-muscle-bedrest},
  certainty       = {0.75}
}

@article{Eggelbusch2024BedrestMetab,
  author        = {Eggelbusch, Moritz and Charlton, Braeden T. and Bosutti, Alessandra and Ganse, Bergita and Giakoumaki, Ifigeneia and Grootemaat, Anita E. and Hendrickse, Paul W. and Jaspers, Yorick and Kemp, Stephan and Kerkhoff, Tom J. and Noort, Wendy and van Weeghel, Michel and van der Wel, Nicole N. and Wesseling, Jorn R. and Frings-Meuthen, Petra and Rittweger, J{\"o}rn and Mulder, Edwin R. and Jaspers, Richard T. and Degens, Hans and W{\"u}st, Rob C. I.},
  title         = {The Impact of Bed Rest on Human Skeletal Muscle Metabolism},
  journal       = {Cell Reports Medicine},
  year          = {2024},
  volume        = {5},
  number        = {1},
  pages         = {101372},
  doi           = {10.1016/j.xcrm.2023.101372},
  pmid          = {38232697},
  pmcid         = {PMC10829795},
  note          = {Same AGBRESA 60d bed rest cohort. Integrative multi-system analysis: intracellular glycogen accumulation at 6d with reduced GLUT4 membrane localization; by 55d: intramyocellular lipid + ceramide/sphingomyelin accumulation, fragmented mitochondria, reduced OXPHOS. Establishes intracellular nutrient overload as key determinant of bed rest-induced insulin resistance and mitochondrial dysfunction. Temporal dissociation of carbohydrate (early) vs lipid (late) metabolic defects. Foundational for understanding what bed rest DOES vs does NOT do to muscle -- a key comparator for Charlton 2026.},
  research_stream = {charlton2026-muscle-bedrest},
  certainty       = {0.80}
}

@article{Joseph2021iCPETmeCFS,
  author        = {Joseph, Phillip and Arevalo, Claudia and Oliveira, Rudolf K. F. and Faria-Urbina, Mariana and Waxman, Aaron B. and Systrom, David M.},
  title         = {Insights From Invasive Cardiopulmonary Exercise Testing of Patients With {ME/CFS}},
  journal       = {Chest},
  year          = {2021},
  volume        = {160},
  number        = {2},
  pages         = {642--651},
  doi           = {10.1016/j.chest.2021.01.082},
  pmid          = {33577778},
  note          = {Invasive CPET (radial + pulmonary artery catheters) in n=20 ME/CFS (Fukuda) vs n=10 healthy controls. ME/CFS: marked reduction in peak systemic O2 extraction (cardiac output \texttimes\ arteriovenous O2 difference), reduced stroke volume augmentation, low biventricular filling pressures (preload failure). Normal pulmonary gas exchange. Evidence that exercise limitation is peripheral (oxygen extraction, preload) not central (lung, heart). Cited as ref 40 in Charlton 2026 -- directly supports the conclusion that cardiovascular limitations in ME/CFS differ from deconditioning.},
  research_stream = {charlton2026-muscle-bedrest},
  certainty       = {0.75},
  diagnostic_criteria = {Fukuda}
}

@article{Singh2022iCPETlongCOVID,
  author        = {Singh, Inderjit and Joseph, Phillip and Heerdt, Paul M. and Cullinan, Marjorie and Lutchmansingh, Denyse D. and Gulati, Mridu and Possick, Jennifer D. and Systrom, David M.},
  title         = {Persistent Exertional Intolerance After {COVID-19}: Insights From Invasive Cardiopulmonary Exercise Testing},
  journal       = {Chest},
  year          = {2022},
  volume        = {161},
  number        = {1},
  pages         = {54--63},
  doi           = {10.1016/j.chest.2021.08.010},
  pmid          = {34389297},
  pmcid         = {PMC8354807},
  note          = {Invasive CPET in n=10 post-COVID patients (9 never hospitalized) with unexplained dyspnea/exercise intolerance. Peak VO2: 71\% predicted. Key finding: reduced peak systemic O2 extraction despite normal cardiac output -- peripheral (not central) limitation. Preload failure in some patients. Cited as ref 41 in Charlton 2026. Confirms impaired peripheral O2 extraction as a hallmark of post-viral exercise intolerance, consistent with the paper's findings of dissociated OXPHOS-VO2max relationship in patients.},
  research_stream = {charlton2026-muscle-bedrest},
  certainty       = {0.70},
  diagnostic_criteria = {custom}
}

@misc{Toriola2026ATG13muscle,
  author        = {Toriola, M. A. and Timlin, E. and Bulbule, S. and Reyes, A. and Adedeji, O. M. and Gottschalk, C. G. and Barua, A. and Arnold, L. A. and Roy, A.},
  title         = {Genetic Depletion of the Early Autophagy Protein {ATG13} Impairs Mitochondrial Energy Metabolism, Augments Oxidative Stress, Induces {M1} Macrophage Polarization, and Compromises Myelin Integrity in Skeletal Muscle},
  journal       = {Inflammation Research},
  year          = {2026},
  volume        = {75},
  number        = {1},
  pages         = {26},
  doi           = {10.1007/s00011-025-02158-6},
  pmid          = {41591477},
  pmcid         = {PMC12847126},
  note          = {Murine model: ATG13 hemizygous deletion disrupts autophagy, impairs mitochondrial OXPHOS, increases ROS, polarizes macrophages to M1 inflammatory mode. M1 macrophage infiltration into muscle vasculature, myelin integrity loss in nerve bundles, reduced muscle strength after treadmill exercise. First direct evidence that impaired autophagy in skeletal muscle can produce PEM-like exercise intolerance. Complements Charlton 2026 findings on mitochondrial dysfunction and identifies autophagy defect as a potential upstream mechanism for the uncoupled OXPHOS-VO2max relationship.},
  research_stream = {charlton2026-muscle-bedrest},
  certainty       = {0.50}
}

@article{Germain2025PlasmaProteomePEM,
  author        = {Germain, Arnaud and Glass, Katherine A. and Eckert, Mary A. and Giloteaux, Ludovic and Hanson, Maureen R.},
  title         = {Temporal Dynamics of the Plasma Proteomic Landscape Reveals Maladaptation in {ME/CFS} Following Exertion},
  journal       = {Molecular \& Cellular Proteomics},
  year          = {2025},
  volume        = {24},
  number        = {12},
  pages         = {101467},
  doi           = {10.1016/j.mcpro.2025.101467},
  pmid          = {41237904},
  pmcid         = {PMC12757482},
  note          = {Longitudinal plasma proteomics (SomaScan 7K, n=79 ME/CFS vs n=53 age/BMI-matched sedentary controls) over 2-day CPET protocol. ME/CFS showed persistent dysregulation of immune, metabolic, and neuromuscular pathways in recovery phase (PEM onset). Upregulated glycolysis/gluconeogenesis suggestive of mitochondrial stress; proteomic associations with VO2max disrupted in ME/CFS. Sex-stratified analyses revealed distinct female vs male responses. Establishes that PEM is accompanied by a specific proteomic signature, not simply deconditioning -- corroborates Charlton 2026's central thesis.},
  research_stream = {charlton2026-muscle-bedrest},
  certainty       = {0.70},
  diagnostic_criteria = {custom}
}

@article{Behan1991MitochondrialPVFS,
  author        = {Behan, W. M. H. and More, I. A. R. and Behan, P. O.},
  title         = {Mitochondrial Abnormalities in the Postviral Fatigue Syndrome},
  journal       = {Acta Neuropathologica},
  year          = {1991},
  volume        = {83},
  number        = {1},
  pages         = {61--65},
  doi           = {10.1007/BF00294431},
  pmid          = {1792865},
  note          = {First study to report mitochondrial abnormalities in post-viral fatigue syndrome muscle biopsies (n=50 PVFS, vastus lateralis). 80\% had abnormal mitochondria on electron microscopy: branching, elongation, compartmentalization of cristae, paracrystalline inclusions. Muscle fiber atrophy type II predominant. Seminal paper establishing structural mitochondrial pathology in post-viral fatigue -- predates Charlton 2026 by 35 years but supports the finding that mitochondrial dysfunction is disease-intrinsic, not deconditioning-driven. Cited as ref 8 in Charlton 2026.},
  research_stream = {charlton2026-muscle-bedrest},
  certainty       = {0.35}
}

