  certainty    = {0.60}
}

@article{Cowden2010H4Pruritus,
  author       = {Cowden, Jeffery M. and Zhang, Mai and Dunford, Paul J. and Thurmond, Robin L.},
  title        = {The histamine H4 receptor mediates inflammation and pruritus in Th2-dependent dermal inflammation},
