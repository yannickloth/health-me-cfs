@article{Maintz2007HistamineIntolerance,
  author       = {Maintz, Laura and Novak, Natalija},
  title        = {Histamine and histamine intolerance},
  journal      = {American Journal of Clinical Nutrition},
  year         = {2007},
  volume       = {85},
  number       = {5},
  pages        = {1185--1196},
  doi          = {10.1093/ajcn/85.5.1185},
  pmid         = {17490952},
  note         = {Seminal review. Histamine intolerance arises when histamine accumulation exceeds degradation capacity. DAO is the main enzyme for ingested/extracellular histamine; HNMT is cytosolic and degrades only intracellular histamine. Low amine-oxidase activity (DAO deficiency) drives symptoms mimicking allergy; symptoms respond to histamine-restricted diet or antihistamines. Raw certainty 0.65, general population -> discounted 0.49.},
  research_stream = {mcas-stack-drug-mechanisms},
  certainty    = {0.65}
}

