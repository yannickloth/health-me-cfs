  pmid         = {25249063},
  note         = {H4R is expressed on eosinophils, mast cells, basophils and Th2 cells and on sensory neurons; H4R-deficient mice and H4R-antagonist-treated mice scratch less. Combined H1R+H4R blockade inhibited itch and chronic allergic inflammation with efficacy comparable to prednisolone; JNJ39758979 (H4R antagonist) showed marked anti-pruritic effect in a phase II AD trial. Raw certainty 0.60, general population -> discounted 0.45.},
  research_stream = {mcas-stack-drug-mechanisms},
  certainty    = {0.60}
}

@article{Walter2011H4Inflammation,
