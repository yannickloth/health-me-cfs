  year         = {2026},
  volume       = {31},
  pages        = {44--53},
  doi          = {10.1016/j.sopen.2026.03.005},
  pmid         = {41952969},
  note         = {Mesenteric mast-cell degranulation after abdominal surgery required intact vagal signalling (prevented by vagotomy); in vitro, mast-cell degranulation was triggered by substance P, nicotine and bethanechol. Demonstrates vagal/cholinergic dependence of mast-cell activation in vivo. Raw certainty 0.50, animal -> discounted 0.25.},
  research_stream = {mcas-stack-drug-mechanisms},
  certainty    = {0.50}
}

