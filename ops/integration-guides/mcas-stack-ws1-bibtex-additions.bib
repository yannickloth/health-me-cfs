  year         = {2010},
  volume       = {130},
  number       = {4},
  pages        = {1023--1033},
  doi          = {10.1038/jid.2009.358},
  pmid         = {19907432},
  note         = {In a Th2-driven mouse skin inflammation model, two H4R antagonists (incl. JNJ 7777120) reduced oedema, mast-cell and eosinophil infiltration, and inhibited itch; ex vivo antigen restimulation reduced IL-4/IL-5/IL-17. Establishes H4R as mediator of pruritus + Th2 inflammation distinct from H1. Raw certainty 0.65, animal -> discounted 0.33.},
  research_stream = {mcas-stack-drug-mechanisms},
  certainty    = {0.65}
}

@article{Ohsawa2014H1H4AtopicDerm,
  author       = {Ohsawa, Yusuke and Hirasawa, Noriyasu},
  title        = {The role of histamine H1 and H4 receptors in atopic dermatitis: from basic research to clinical study},
